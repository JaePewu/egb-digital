{
  "name": "egb-digital-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "vercel-build": "prisma db push && node scripts/seed.js --if-empty && next build --webpack",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed.js",
    "db:setup": "prisma db push && node scripts/seed.js --if-empty",
    "db:reset": "prisma db push --force-reset && node scripts/seed.js",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "fast-xml-parser": "^5.9.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
